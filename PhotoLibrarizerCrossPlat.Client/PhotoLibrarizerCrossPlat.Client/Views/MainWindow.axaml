<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PhotoLibrarizerCrossPlat.Client.Views"
        xmlns:viewModels="clr-namespace:PhotoLibrarizerCrossPlat.Client.ViewModels"
        xmlns:local="clr-namespace:PhotoLibrarizerCrossPlat.Client.Converters;assembly=PhotoLibrarizerCrossPlat.Client"
        x:Class="PhotoLibrarizerCrossPlat.Client.Views.MainWindow"
        Title="PhotoLibrarizerCrossPlat.Client"
        x:DataType="viewModels:MainWindowViewModel">
    <Window.Resources>
        <local:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter"/>
    </Window.Resources>
    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Background="Gray">
            <TextBlock Text="Header" Foreground="White" FontWeight="Bold" FontSize="24" Margin="10"/>
            <views:PathBarView DataContext="{Binding PathBar}"/>
        </StackPanel>

        <views:ImageViewer DataContext="{Binding PathBar.ImageViewer}"/>
    </DockPanel>
</Window>